<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RadioGroup
            android:id="@+id/rgUsbMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/rbAdb"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ADB port-forward (dev/test)" />

            <RadioButton
                android:id="@+id/rbAccessory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="USB Accessory Mode" />
        </RadioGroup>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Tunnel port (default 8081)">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etUsbPort"
                android:inputType="number"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/tvUsbStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Status: Disconnected"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="ADB mode tip:\nOn the PC run:\n  adb forward tcp:8081 tcp:8080\nThen use http://localhost:8081/" />

        <Button
            android:id="@+id/btnUsbTest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Test USB Connection" />
    </LinearLayout>
</ScrollView>
